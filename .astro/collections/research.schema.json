{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "year": {
      "type": "number"
    },
    "type": {
      "type": "string"
    },
    "journal": {
      "type": "string"
    },
    "doi": {
      "type": "string"
    },
    "citations": {
      "default": 0,
      "type": "number"
    },
    "scholarCitations": {
      "default": 0,
      "type": "number"
    },
    "oaStatus": {
      "default": "closed",
      "type": "string"
    },
    "isOA": {
      "default": false,
      "type": "boolean"
    },
    "githubUrl": {
      "type": "string"
    },
    "scholarUrl": {
      "type": "string"
    },
    "keywords": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "labAuthorIndices": {
      "default": [],
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "highlight": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "authors",
    "year",
    "type"
  ]
}